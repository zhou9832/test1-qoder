##############################################################################
##
##  Gradle start up script for POSIX generated by Gradle.
##
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path#"${app_path%%!*/}"}
    case $APP_HOME in
        /*) break ;;
    esac
    app_path=$(dirname "$app_path")"/$(basename "${app_path#!*/}")
done

# For Cygwin; switch paths to Windows format before running java
if [ "$(uname -a)" | grep -q "CYGWIN*" ]; then
    app_path=$(cygpath -w "$app_path")
    APP_HOME=$(cygpath -w "$app_home")
fi

# Set default Gradle home
APP_HOME=$(cd "${APP_HOME:-./}" && pwd -P) || exit

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    printf "%s\n" "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$(uname)" in
  CYGWIN*)
    cygwin=true
    ;;
  Darwin*)
    darwin=true
    ;;
  MINGW*)
    msys=true
    ;;
  NONSTOP*)
    nonstop=true
    ;;
esac

JAVA_CMD="java"

# Collect all arguments for the java command
set -- \
    -Dorg.gradle.appname="$APP_BASE_NAME"\
    -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar"\
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

# Use -Xmx512m as default heap size
JAVA_OPTS="-Xmx512m"

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVA_CMD="$JAVA_HOME/jre/sh/java"
    else
        JAVA_CMD="$JAVA_HOME/bin/java"
    fi
else
    which java >/dev/null 2>&1 || die "You need to set JAVA_HOME before running this script"
fi

# Store args for later
set -- $JAVA_OPTS $JAVA_CMD $@

if $cygwin; then
    CLASSPATH=$(cygpath -w "$CLASSPATH")
    APP_HOME=$(cygpath -w "$APP_HOME")
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    if [ $(ulimit -H -n) -gt 0 ] ; then
        nlimit=$(ulimit -n 256)
    fi
fi

exec "$JAVA_CMD" $JAVA_OPTS -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
